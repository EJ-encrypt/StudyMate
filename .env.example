# StudyMate configuration.
#
# In production every one of these goes into Vercel:
#   Project -> Settings -> Environment Variables.
# For running locally, copy this file to .env and fill it in.
# Never commit .env; it holds real keys.
# docs/deployment.md says where each value comes from.

# ---------------------------------------------------------------- Backend ---

# 'production' refuses to start unless the Supabase keys and CRON_SECRET are set.
ENVIRONMENT=production

# The address students open, used for links in reminder emails and notifications.
APP_URL=https://your-app.vercel.app

# Supabase -> Connect -> Transaction pooler (port 6543). Replace [YOUR-PASSWORD].
# For running migrations from your PC, use the Session pooler URL (port 5432) instead.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# The service_role / secret key. Server-side only: never put it in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase -> Project Settings -> JWT Keys -> Legacy JWT secret. Only used if
# your project still signs tokens with it; harmless to set either way.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=lecture-files

# Any long random string; the scheduler sends it with every tick.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# Web push. Generate once: cd backend && python -m app.scripts.vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email reminders. With Gmail: turn on 2-Step Verification, then create an
# app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=StudyMate <you@gmail.com>

# AI providers, tried in order. The first serves requests; the rest are used
# when it fails, which on free tiers happens often. A provider without a key
# is skipped. Both of these have free tiers.
AI_PROVIDERS=gemini,mistral
# Model lists are configuration because providers retire models without notice.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
MISTRAL_MODELS=mistral-small-latest,mistral-medium-latest
# Free-tier Google AI Studio key (https://aistudio.google.com/apikey) -- no billing required.
GEMINI_API_KEY=
# Free "Experiment" plan key from https://console.mistral.ai (phone verification).
MISTRAL_API_KEY=

# --------------------------------------------------------------- Frontend ---
# Baked into the browser bundle at build time, so these must be public values.

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# The anon / publishable key (safe to expose; row-level security protects data).
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=lecture-files
