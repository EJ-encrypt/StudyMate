# Backend
# Set to 'production' for anything other people can reach. That refuses to
# start on the placeholder secret below.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://studymate:studymate@postgres:5432/studymate
REDIS_URL=redis://redis:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# AI providers, tried in order. The first serves requests; the rest are used
# when it fails, which on free tiers happens often. e.g. gemini,openai
AI_PROVIDERS=gemini

# Model lists are configuration because providers retire models without notice.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
OPENAI_MODELS=gpt-4o-mini

# Free-tier Google AI Studio key (https://aistudio.google.com/apikey) -- no billing required.
GEMINI_API_KEY=

# Only needed if openai is in AI_PROVIDERS.
OPENAI_API_KEY=

# Postgres password, used by the production compose file.
POSTGRES_PASSWORD=studymate

# Frontend
# Leave blank in production: the API serves the frontend, so it calls its own origin.
VITE_API_BASE_URL=http://localhost:9000
